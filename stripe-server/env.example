# Copy to .env and fill in.

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Site URL (no trailing slash) — used for success/cancel redirects and CORS
CLIENT_URL=http://localhost:5500

# Server port
PORT=3000

# Outgoing email (order copy to customer). Use Gmail app password, Resend SMTP, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Discord Studio <your@gmail.com>"

# Optional: BCC yourself on every order
EMAIL_BCC=
