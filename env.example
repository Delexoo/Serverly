# Copy to .env and fill in.

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Public URL of the wizard (no trailing slash). Must match where the site actually loads.
# GitHub Pages project site: https://YOURUSER.github.io/RepoName   (include /RepoName)
# Wrong: https://YOURUSER.github.io  → Stripe would send buyers to the user root (404).
CLIENT_URL=http://localhost:5500

# Optional: CORS origin if the browser blocks checkout (defaults to origin of CLIENT_URL).
# CORS_ORIGIN=https://YOURUSER.github.io

# Server port
PORT=3000

# Outgoing email (order copy to customer). Use Gmail app password, Resend SMTP, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Serverly <your@gmail.com>"

# Optional: BCC yourself on every order
EMAIL_BCC=
