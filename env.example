# Copy to .env and fill in.

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Public URL of the wizard (no trailing slash). Must match where the site actually loads.
# Either put the full path here:
#   CLIENT_URL=https://YOURUSER.github.io/RepoName
# Or use your GitHub user URL plus a separate path (common mistake fix):
#   CLIENT_URL=https://YOURUSER.github.io
#   CLIENT_SITE_PATH=RepoName
CLIENT_URL=http://localhost:5500
# CLIENT_SITE_PATH=Serverly

# Optional: CORS origin if the browser blocks checkout (defaults to origin of CLIENT_URL).
# CORS_ORIGIN=https://YOURUSER.github.io

# Server port
PORT=3000

# Outgoing email (order copy to customer). Use Gmail app password, Resend SMTP, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Serverly <your@gmail.com>"

# Optional: BCC yourself on every order
EMAIL_BCC=
