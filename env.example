# Copy to .env and fill in.

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Public URL of the wizard (no trailing slash). Must match where the site actually loads.
# Either put the full path here:
#   CLIENT_URL=https://YOURUSER.github.io/RepoName
# Or use your GitHub user URL plus a separate path (required if CLIENT_URL has no /Repo):
#   CLIENT_URL=https://YOURUSER.github.io
#   CLIENT_SITE_PATH=Serverly
# Without CLIENT_SITE_PATH, Stripe will redirect to https://YOURUSER.github.io/thank-you.html → 404.
CLIENT_URL=http://localhost:5500
# CLIENT_SITE_PATH=Serverly

# Optional: CORS origin if the browser blocks checkout (defaults to origin of CLIENT_URL).
# CORS_ORIGIN=https://YOURUSER.github.io

# Server port
PORT=3000

# Outgoing email (order copy to customer). Use Gmail app password, Resend SMTP, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Serverly <your@gmail.com>"

# Optional: BCC yourself on every order
EMAIL_BCC=

# Optional: immediate digital product URL (PDF, Google Drive, Notion, etc.) — included in order email + invoice context.
# Paste the same URL into thank-you.html meta name="serverly-digital-delivery-url" so the thank-you page shows an "Open resource" button.
# DIGITAL_DELIVERY_URL=https://example.com/your-starter-guide.pdf

# Discord server template URLs (never commit real links in HTML/JS). Resolved server-side; see template-registry.js for keys.
# Advanced + Content creator + Column (style card "Column")
# CONTENT_CREATOR_COLUMN=https://discord.new/your-template-code
